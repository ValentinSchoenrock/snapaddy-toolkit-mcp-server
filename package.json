{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "A Model Context Protocol server implementation in TypeScript",
  "homepage": "https://github.com/ValentinSchoenrock/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ValentinSchoenrock/mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValentinSchoenrock/mcp-server.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "bin": {
    "mcp-server": "./build/index.js"
  },
  "scripts": {
    "start": "node --inspect build/index.js",
    "dev": "npm-run-all -p watch dev:server",
    "dev:server": "nodemon --config nodemon.json",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  }
}